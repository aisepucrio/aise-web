{
  "name": "monorepo-root",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:editor": "npm run dev --workspace apps/editor",
    "dev:main": "npm run dev --workspace apps/main",
    "postinstall": "npm run generate --workspace packages/db"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0"
  }
}
